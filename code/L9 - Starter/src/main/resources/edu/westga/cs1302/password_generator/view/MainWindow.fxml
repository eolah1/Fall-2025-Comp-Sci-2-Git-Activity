<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="443.0" prefWidth="215.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.password_generator.view.MainWindow">
   <children>
      <CheckBox fx:id="mustIncludeDigits" layoutX="14.0" layoutY="118.0" mnemonicParsing="false" text="Must Include Digits" />
      <CheckBox fx:id="mustIncludeLowerCaseLetters" layoutX="14.0" layoutY="154.0" mnemonicParsing="false" text="Must Include Lower Case Letters" />
      <CheckBox fx:id="mustIncludeUpperCaseLetters" layoutX="13.0" layoutY="194.0" mnemonicParsing="false" text="Must Include Upper Case Letters" />
      <Button fx:id="generatePasswordButton" layoutX="46.0" layoutY="227.0" mnemonicParsing="false" text="Generate Password" />
      <Label layoutX="14.0" layoutY="38.0" text="Minimum Length" />
      <TextField fx:id="minimumLength" layoutX="118.0" layoutY="34.0" prefHeight="25.0" prefWidth="41.0" />
      <ListView fx:id="passwordHistory" layoutX="5.0" layoutY="263.0" prefHeight="169.0" prefWidth="200.0" />
      <Label fx:id="errorTextLabel" layoutX="8.0" layoutY="66.0" prefHeight="17.0" prefWidth="199.0" textFill="RED" />
