<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1">
   <children>
      <AnchorPane layoutX="10.0" layoutY="10.0" minHeight="151.0" minWidth="215.0" prefHeight="171.0" prefWidth="367.0">
         <children>
            <Button fx:id="removeCollection" layoutX="287.0" layoutY="62.0" mnemonicParsing="false" onAction="#handleRemoveCollection" text="Cancel" />
            <Button fx:id="addCollection" layoutX="283.0" layoutY="14.0" mnemonicParsing="false" onAction="#handleAddCollection" text="Confirm" />
            <TextField fx:id="issueNumber" layoutX="14.0" layoutY="62.0" prefHeight="26.0" prefWidth="252.0" promptText="Enter Issue #" />
            <TextField fx:id="comicName" layoutX="14.0" layoutY="14.0" prefHeight="26.0" prefWidth="252.0" promptText="Enter Comic Name" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
