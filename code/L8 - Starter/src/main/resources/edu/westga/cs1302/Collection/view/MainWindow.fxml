<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="494.0" prefWidth="367.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.Collection.view.MainWindow">
   <children>
      <Button fx:id="removeCollection" layoutX="213.0" layoutY="156.0" mnemonicParsing="false" onAction="#handleRemoveCollection" text="Remove Collection" />
      <ListView fx:id="displayCollections" layoutX="187.0" layoutY="24.0" prefHeight="174.0" prefWidth="166.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#removeFromContext" text="Remove Collection" />
              </items>
            </ContextMenu>
         </contextMenu></ListView>
      <Button fx:id="addCollection" layoutX="49.0" layoutY="59.0" mnemonicParsing="false" onAction="#handleAddCollection" text="Add Collection" />
      <TextField fx:id="collectionName" layoutX="25.0" layoutY="24.0" promptText="Enter Collection Name" />
      <ListView fx:id="displayComics" layoutX="16.0" layoutY="198.0" prefHeight="174.0" prefWidth="166.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#removeComicFromContext" text="Remove Comic" />
              </items>
            </ContextMenu>
         </contextMenu>
      </ListView>
      <Button fx:id="addComic" layoutX="58.0" layoutY="98.0" mnemonicParsing="false" onAction="#handleAddComic" text="Add Comic" />
      <Button fx:id="removeComic" layoutX="48.0" layoutY="143.0" mnemonicParsing="false" onAction="#handleRemoveComic" text="Remove Comic" />
      <TextField fx:id="titleField" layoutX="195.0" layoutY="285.0" promptText="Enter Comic Title" />
      <TextField fx:id="issueField" layoutX="195.0" layoutY="234.0" promptText="Enter Issue Number" />
      <Button fx:id="findComic" layoutX="232.0" layoutY="336.0" mnemonicParsing="false" onAction="#handleFindComic" text="Find Comic" />
   </children>
</AnchorPane>
