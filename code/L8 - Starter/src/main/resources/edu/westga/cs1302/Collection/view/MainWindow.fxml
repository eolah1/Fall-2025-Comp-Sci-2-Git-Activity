<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane minHeight="366.0" minWidth="215.0" prefHeight="494.0" prefWidth="325.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.Collection.view.MainWindow">
   <children>
      <Button fx:id="removeCollection" layoutX="107.0" layoutY="234.0" mnemonicParsing="false" onAction="#handleRemoveCollection" text="Remove Collection" />
      <ListView fx:id="displayCollections" layoutX="68.0" layoutY="276.0" prefHeight="174.0" prefWidth="194.0">
         <contextMenu>
            <ContextMenu>
              <items>
                <MenuItem mnemonicParsing="false" onAction="#removeFromContext" text="Remove" />
              </items>
            </ContextMenu>
         </contextMenu></ListView>
      <Button fx:id="addCollection" layoutX="117.0" layoutY="188.0" mnemonicParsing="false" onAction="#handleAddCollection" text="Add Collection" />
      <TextField fx:id="collectionName" layoutX="91.0" layoutY="114.0" promptText="Enter Collection Name" />
   </children>
</AnchorPane>
